<script>
(function(){
  const shapes = document.querySelectorAll('.geo-shape');
  const speed = [0.03, 0.05, 0.02, 0.04, 0.06, 0.035];
  let ticking = false;
  window.addEventListener('scroll', function(){
    if(!ticking){
      requestAnimationFrame(function(){
        const scrollY = window.scrollY;
        shapes.forEach(function(s, i){
          const rate = speed[i % speed.length];
          const yOff = scrollY * rate;
          const rot = scrollY * rate * 0.3;
          s.style.transform = 'translateY(' + yOff + 'px) rotate(' + rot + 'deg)';
        });
        ticking = false;
      });
      ticking = true;
    }
  });
  document.addEventListener('mousemove', function(e){
    shapes.forEach(function(s){
      const rect = s.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) * 0.015;
      const dy = (e.clientY - cy) * 0.015;
      s.style.setProperty('--mouse-x', dx + 'px');
      s.style.setProperty('--mouse-y', dy + 'px');
    });
  });
})();
</script>
